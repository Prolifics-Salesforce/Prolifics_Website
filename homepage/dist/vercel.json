{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ],
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/happenings",
   "destination": "/events",
   "permanent": false
  },
  {
   "source": "/happenings/:slug",
   "destination": "/events/:slug",
   "permanent": false
  },
  {
   "source": "/solutions",
   "destination": "/services",
   "permanent": false
  },
  {
   "source": "/solutions/:p*",
   "destination": "/services",
   "permanent": false
  }
 ],
 "rewrites": [
  {
   "source": "/events/:slug",
   "destination": "/events/detail"
  },
  {
   "source": "/resources/article/:slug",
   "destination": "/resources/article"
  }
 ]
}