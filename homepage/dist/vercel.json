{
 "headers": [
  {
   "source": "/resources/article",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/resources/item",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/events/detail",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/thank-you",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ],
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/happenings",
   "destination": "/events",
   "permanent": false
  },
  {
   "source": "/happenings/:slug",
   "destination": "/events/:slug",
   "permanent": false
  },
  {
   "source": "/resources/forward-deployed-ai-vs-consulting",
   "destination": "/resources/article/forward-deployed-ai-vs-consulting",
   "permanent": false
  },
  {
   "source": "/resources/ai-data-readiness",
   "destination": "/resources/article/ai-data-readiness",
   "permanent": false
  },
  {
   "source": "/resources/enterprise-ai-evaluation",
   "destination": "/resources/article/enterprise-ai-evaluation",
   "permanent": false
  },
  {
   "source": "/solutions",
   "destination": "/services",
   "permanent": false
  },
  {
   "source": "/solutions/:p*",
   "destination": "/services",
   "permanent": false
  }
 ],
 "rewrites": [
  {
   "source": "/sitemap.xml",
   "destination": "/api/sitemap"
  },
  {
   "source": "/robots.txt",
   "destination": "/api/sitemap?file=robots"
  },
  {
   "source": "/events/:slug",
   "destination": "/events/detail"
  },
  {
   "source": "/resources/article/:slug",
   "destination": "/resources/article"
  },
  {
   "source": "/resources/item/:slug",
   "destination": "/resources/item"
  }
 ]
}